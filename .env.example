# 1) 이 파일을 복사해 이름을 .env 로 바꾼 뒤 값을 입력하세요. (.env 는 git에 올라가지 않습니다)
# 2) OpenAI API 키: https://platform.openai.com/api-keys 에서 발급
OPENAI_API_KEY=sk-여기에_API_키를_입력하세요

# 사용할 AI 모델 이름 (본인 계정에서 사용 가능한 모델로 변경 가능)
OPENAI_MODEL=gpt-4.1-mini

# AI 응답 대기 시간(초)
OPENAI_TIMEOUT=180

# AI 1회 호출에 넣을 최대 글자 수. 모델 입력 한도에 맞춰 조정하세요.
# (한국어는 대략 1글자 = 1토큰. 128k 토큰 모델이면 100000 정도로 낮추세요.)
MAX_INPUT_CHARS=300000

# 과거 사례 원본 문서 1개당 AI에 넣는 최대 글자 수 (초과 시 화면에 알리고 앞부분만 사용)
PAST_DOC_MAX_CHARS=20000

# AI가 참고용으로 고를 수 있는 과거 사례 최대 개수
MAX_SELECTED_CASES=5

# 업로드 파일 1개당 최대 크기(MB) - 50 이하로 설정
MAX_FILE_MB=20
